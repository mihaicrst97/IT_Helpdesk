# PostgreSQL
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=helpdesk_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://helpdesk:change_me_postgres_password@localhost:5432/helpdesk_db?schema=public

# Backend API
NODE_ENV=development
PORT=3000
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# RabbitMQ
RABBITMQ_DEFAULT_USER=helpdesk
RABBITMQ_DEFAULT_PASS=change_me_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://helpdesk:change_me_rabbitmq_password@localhost:5672
RABBITMQ_EXCHANGE=helpdesk_topic_exchange
RABBITMQ_QUEUE=notifications_queue

# Discord Webhooks (Category Routing)
DISCORD_WEBHOOK_HW=
DISCORD_WEBHOOK_SW=
DISCORD_WEBHOOK_LIC=
DISCORD_WEBHOOK_NET=

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=/api
