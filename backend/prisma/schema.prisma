generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  CRITICAL
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  email           String               @unique
  passwordHash    String               @map("password_hash")
  fullName        String               @map("full_name")
  role            Role                 @default(USER)
  createdAt       DateTime             @default(now()) @map("created_at")
  createdTickets  Ticket[]             @relation("TicketAuthor")
  assignedTickets Ticket[]             @relation("TicketAssignee")
  comments        Comment[]
  certifications  AdminCertification[]

  @@map("users")
}

model Category {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  discordChannelKey   String               @map("discord_channel_key")
  tickets             Ticket[]
  adminCertifications AdminCertification[]

  @@map("categories")
}

model AdminCertification {
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  certifiedAt DateTime @default(now()) @map("certified_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@map("admin_certifications")
}

model Ticket {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority
  categoryId      String         @map("category_id") @db.Uuid
  authorId        String         @map("author_id") @db.Uuid
  assignedAdminId String?        @map("assigned_admin_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  category        Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author          User           @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  assignedAdmin   User?          @relation("TicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  comments        Comment[]

  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@map("tickets")
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  content   String
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("comments")
}
